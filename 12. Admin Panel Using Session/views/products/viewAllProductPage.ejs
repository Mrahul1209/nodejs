<%- include('../header') %>
    <div class="main-content">
        <div class="content-header">
            <h1><i class="fas fa-tags"></i> All Products</h1>
            <p>Manage all extra categories</p>
        </div>

        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th width="60">ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th> Sub Category</th>
                        <th> Extra Category</th>
                        <th>Category Image</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% allProducts.map((category, index)=> { %>
                        <tr>
                            <td>
                                <span class="badge badge-success">#<%= index + 1 %></span>
                            </td>
                            <td>
                                <div class="admin-profile-cell">
                                    <div class="admin-name-info">
                                        <strong>
                                            <%= category.product_name %>
                                        </strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="admin-profile-cell">
                                    <div class="admin-name-info">
                                        <strong>
                                            <%= category.category_id.category_name %>
                                        </strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="admin-profile-cell">
                                    <div class="admin-name-info">
                                        <strong>
                                            <%= category.sub_category_id.sub_category_name %>
                                        </strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="admin-profile-cell">
                                    <div class="admin-name-info">
                                        <strong>
                                            <%= category.extra_category_id.extra_category_name %>
                                        </strong>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <img src="../<%= category.category_id.category_image%>" alt="" width="50">
                            </td>

                            <td class="text-right">
                                <div class="action-buttons">
                                    <a href="/product/editProductPage?productId=<%= category.id %>"
                                        class="btn btn-sm btn-secondary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/product/deleteProduct/<%= category.id %>" class="btn btn-sm btn-danger"
                                        title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <%- include('../footer') %>