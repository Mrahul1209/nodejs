    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.18/dist/sweetalert2.all.min.js"></script>


    <script>

        const allSubCategories = <%- JSON.stringify(allSubCategory) %>;
        const allExtraCategories = <%- JSON.stringify(allExtraCategory) %>;

        const category = document.getElementById('category');
        const subcategory = document.getElementById('subcategory');
        const extracategory = document.getElementById('extracategory');

        // Initial State
        subcategory.disabled = true;
        extracategory.disabled = true;

        // =============================
        // Category → SubCategory
        // =============================
        category.addEventListener('change', function () {

            const selectedId = this.value;

            subcategory.innerHTML = '<option value="">Select Sub Category</option>';
            extracategory.innerHTML = '<option value="">Select Extra Category</option>';

            extracategory.disabled = true;

            if (!selectedId) {
                subcategory.disabled = true;
                return;
            }

            subcategory.disabled = false;

            const filteredSubCategories = allSubCategories.filter(sub =>
                sub.category_id.toString() === selectedId
            );

            filteredSubCategories.forEach(sub => {
                subcategory.innerHTML += `
            <option value="${sub._id}">
                ${sub.sub_category_name}
            </option>
        `;
            });
        });

        // =============================
        // SubCategory → ExtraCategory
        // =============================
        subcategory.addEventListener('change', function () {

            const selectedSubId = this.value;

            extracategory.innerHTML = '<option value="">Select Extra Category</option>';

            if (!selectedSubId) {
                extracategory.disabled = true;
                return;
            }

            extracategory.disabled = false;

            const filteredExtraCategories = allExtraCategories.filter(extra =>
                extra.sub_category_id.toString() === selectedSubId
            );

            filteredExtraCategories.forEach(extra => {
                extracategory.innerHTML += `
            <option value="${extra._id}">
                ${extra.extra_category_name}
            </option>
        `;
            });
        });

        if (<%= locals.flash.success.length > 0 && locals.flash.success !== "" %>) {
            Swal.fire({
                position: "center",
                icon: "success",
                title: "<%= locals.flash.success %>",
                showConfirmButton: false,
                timer: 1500
            });
        }

        if (<%= locals.flash.error.length > 0 && locals.flash.error !== "" %>) {
            Swal.fire({
                position: "center",
                icon: "error",
                title: "<%= locals.flash.error %>",
                showConfirmButton: false,
                timer: 1500
            });
        }

        // header buttons dropdown logic
        const dropdownBtn = document.querySelector('.dropdown-btn');
        const userDropdown = document.querySelector('.user-dropdown');

        dropdownBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userDropdown.classList.toggle('active');
        });

        document.addEventListener('click', () => {
            userDropdown.classList.remove('active');
        });

        document.querySelectorAll('.sidebar-dropdown-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const parent = btn.parentElement;
                parent.classList.toggle('active');

                const menu = parent.querySelector('.sidebar-dropdown-menu');
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            });
        });


    </script>

    </body>

    </html>