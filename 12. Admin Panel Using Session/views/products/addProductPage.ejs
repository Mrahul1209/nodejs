<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Add Product</h1>
            <p>Fill in the details below to add a new product.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i>Sub Category Details</h3>

            <form action="/product/addProduct" method="POST" class="employee-form" enctype="multipart/form-data">
                <div class="form-grid">
                    <!-- product name section  -->
                    <div class="form-group">
                        <label for="productName">Name</label>
                        <input type="text" id="productName" name="product_name" placeholder="Product Name">
                    </div>

                    <!-- product old price section  -->
                    <div class="form-group">
                        <label for="productOldPrice">Old Price</label>
                        <input type="text" id="productOldPrice" name="product_old_price"
                            placeholder="Product Old Price">
                    </div>

                    <!-- product price section  -->
                    <div class="form-group">
                        <label for="productPrice">Price</label>
                        <input type="text" id="productPrice" name="product_price" placeholder="Product Price">
                    </div>

                    <!-- product stock section  -->
                    <div class="form-group">
                        <label for="productStock">Stock</label>
                        <input type="text" id="productStock" name="product_stock" placeholder="Product Stock">
                    </div>

                    <!-- product description section  -->
                    <div class="form-group">
                        <label for="productDescription">Description</label>
                        <textarea name="product_description" id="productDescription"
                            placeholder="Product Description"></textarea>
                    </div>

                    <!-- Product Image section  -->
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" id="product_image" name="product_image" required>
                    </div>

                    <!-- add here drop down of categories  -->
                    <div class="form-group">
                        <label for="department">Category</label>
                        <select id="category" name="category_id">
                            <option value="">Select Category</option>
                            <%allCategory.map(category=> { %>
                                <option value="<%= category.id %>">
                                    <%= category.category_name%>
                                </option>
                                <%})%>

                        </select>
                    </div>

                    <!-- add here drop down of sub categories  -->
                    <div class="form-group">
                        <label for="department">Sub Category</label>
                        <select id="subcategory" name="sub_category_id">
                            <option value="">Select Category</option>
                            <%allSubCategory.map(category=> { %>
                                <option value="<%= category.id %>">
                                    <%= category.sub_category_name%>
                                </option>
                                <%})%>
                        </select>
                    </div>

                    <!-- add here drop down of sub categories  -->
                    <div class="form-group">
                        <label for="department">Extra Category</label>
                        <select id="extracategory" name="extra_category_id">
                            <option value="">Select Extra Category</option>
                            <%allExtraCategory.map(category=> { %>
                                <option value="<%= category.id %>">
                                    <%= category.extra_category_name%>
                                </option>
                                <%})%>
                        </select>
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Sub Category
                    </button>
                </div>
            </form>
        </div>
    </main>


