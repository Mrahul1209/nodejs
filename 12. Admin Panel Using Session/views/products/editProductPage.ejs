<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Edit Category</h1>
            <p>Fill in the details below to edit category.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i>Category Details</h3>

            <form action="/product/editProduct/<%= editProduct.id%>" method="post" class="employee-form"
                enctype="multipart/form-data">
                <div class="form-grid">
                    <!-- product name section section  -->
                    <div class="form-group">
                        <label for="category_name">Product Name</label>
                        <input type="text" id="product_name" name="product_name"
                            value="<%= editProduct.product_name %>">
                    </div>

                    <!-- product_old_price section  -->
                    <div class="form-group">
                        <label for="product_old_price">Product Old Price</label>
                        <input type="text" id="product_old_price" name="product_old_price"
                            value="<%= editProduct.product_old_price %>">
                    </div>

                    <!-- product_price section  -->
                    <div class="form-group">
                        <label for="product_price">Product Price</label>
                        <input type="text" id="product_price" name="product_price"
                            value="<%= editProduct.product_price %>">
                    </div>

                    <!-- product stock section  -->
                    <div class="form-group">
                        <label for="product_stock">Product Stock</label>
                        <input type="text" id="product_stock" name="product_stock"
                            value="<%= editProduct.product_stock %>">
                    </div>

                    <!-- product description section  -->
                    <div class="form-group">
                        <label for="product_description">Product Description</label>
                        <input type="text" id="product_description" name="product_description"
                            value="<%= editProduct.product_description %>">
                    </div>

                    <!-- product current image section  -->
                    <div class="form-group">
                        <label for="product_description">Product Current Image</label>
                        <img src="../<%= editProduct.product_image%>" alt="" width="70">
                    </div>

                    <!-- Product Image section  -->
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" id="product_image" name="product_image">
                    </div>

                    <!-- add here drop down of categories  -->
                    <div class="form-group">
                        <label for="department">Category</label>
                        <select id="category" name="category_id">
                            <option value="">Select Category</option>
                            <% allCategory.map(category=> { %>
                                <option <%=(category._id.toString()===editProduct.category_id._id.toString())
                                    ? "selected" : "" %>
                                    value="<%= category.id %>">
                                        <%= category.category_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <!-- add here drop down of sub categories  -->
                    <div class="form-group">
                        <label for="department">Sub Category</label>
                        <select id="subcategory" name="sub_category_id">
                            <option value="">Select Sub Category</option>
                            <% filteredAllSubCategory.map(sub_category=> { %>
                                <option <%=(sub_category._id.toString()===editProduct.sub_category_id._id.toString())
                                    ? "selected" : "" %>
                                    value="<%= sub_category._id %>">
                                        <%= sub_category.sub_category_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <!-- add here drop down of extra categories  -->
                    <div class="form-group">
                        <label for="department">Extra Category</label>
                        <select id="subcategory" name="extra_category_id">
                            <option value="">Select Extra Category</option>
                            <% filteredAllExtraCategory.map(extra_category=> { %>
                                <option
                                    <%=(extra_category._id.toString()===editProduct.extra_category_id._id.toString())
                                    ? "selected" : "" %>
                                    value="<%= extra_category.id %>">
                                        <%= extra_category.extra_category_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Category
                    </button>
                </div>
            </form>
        </div>
    </main>

