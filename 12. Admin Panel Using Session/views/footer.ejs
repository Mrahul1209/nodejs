<!-- Main JavaScript -->
<script src="/public/script.js"></script>

<!-- Flash Messages -->
<script>
    if (<%= locals.flash.success.length > 0 && locals.flash.success !== "" %>) {
        Swal.fire({
            position: "center",
            icon: "success",
            title: "<%= locals.flash.success %>",
            showConfirmButton: false,
            timer: 2000,
            toast: true,
            background: '#f0fdf4',
            iconColor: '#10b981'
        });
    }

    if (<%= locals.flash.error.length > 0 && locals.flash.error !== "" %>) {
        Swal.fire({
            position: "center",
            icon: "error",
            title: "<%= locals.flash.error %>",
            showConfirmButton: false,
            timer: 2000,
            toast: true,
            background: '#fef2f2',
            iconColor: '#ef4444'
        });
    }
</script>

