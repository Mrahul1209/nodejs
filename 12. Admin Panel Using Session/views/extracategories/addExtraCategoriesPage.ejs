<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Add Extra Category</h1>
            <p>Fill in the details below to add a new extra category.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i>Extra Category Details</h3>

            <form action="/extraCategory/addExtraCategory" method="POST" class="employee-form">
                <div class="form-grid">
                    <!-- first name section  -->
                    <div class="form-group">
                        <label for="firstName">Extra Category Name</label>
                        <input type="text" id="firstName" name="extra_category_name" placeholder="Extra Category">
                    </div>

                    <!-- add here drop down of categories  -->
                    <div class="form-group">
                        <label for="department">Category</label>
                        <select id="category" name="category_id">
                            <option value="">Select Category</option>
                            <% allCategory.map(item=> { %>
                                <option value="<%= item.id %>">
                                    <%= item.category_name %>
                                </option>
                                <%}) %>
                        </select>
                    </div>

                    <!-- add here drop down of sub categories  -->
                    <div class="form-group">
                        <label for="department">Sub Category</label>
                        <select id="subcategory" name="sub_category_id">
                            <option value="">Select Sub Category</option>
                        </select>
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Extra Category
                    </button>
                </div>
            </form>
        </div>
    </main>

