<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Edit Category</h1>
            <p>Fill in the details below to edit category.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i>Category Details</h3>

            <form action="/extraCategory/updateExtraCategory/<%= editExtraCategory.id %>" method="post"
                class="employee-form">
                <div class="form-grid">
                    <!-- first name section  -->
                    <div class="form-group">
                        <label for="category_name">Extra Category Name</label>
                        <input type="text" id="extra_category_name" name="extra_category_name"
                            value="<%= editExtraCategory.extra_category_name %>">
                    </div>

                    <!-- add here drop down of categories  -->
                    <div class="form-group">
                        <label for="department">Category</label>
                        <select id="category" name="category_id">
                            <option value="">Select Category</option>
                            <% allCategory.map(category=> {%>
                                <option <%=(category.id===editExtraCategory.category_id.id) ? "selected" : "" %> value=
                                    <%= category.id %>>
                                        <%= category.category_name %>
                                </option>
                                <%}) %>
                        </select>
                    </div>

                    <!-- add here drop down of sub categories  -->
                    <div class="form-group">
                        <label for="department">Category</label>
                        <select id="subcategory" name="sub_category_id">
                            <option value="">Select Sub Category</option>
                            <% filteredAllSubCategory.map(sub=> { %>
                                <option <%=(sub._id.toString()===editExtraCategory.sub_category_id._id.toString())
                                    ? "selected" : "" %>
                                    value="<%= sub.id %>">
                                        <%= sub.sub_category_name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Category
                    </button>
                </div>
            </form>
        </div>
    </main>

