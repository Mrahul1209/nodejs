    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.18/dist/sweetalert2.all.min.js"></script>


    <script>

        const allSubCategories = <%- JSON.stringify(allSubCategory) %>;

        category.addEventListener('change', function () {

            const selectedId = this.value;

            subcategory.innerHTML = '<option value="">Select Sub Category</option>';

            const filtered = allSubCategories.filter(sub =>
                sub.category_id === selectedId
            );

            filtered.forEach(sub => {
                subcategory.innerHTML += `
            <option value="${sub._id}">
                ${sub.sub_category_name}
            </option>
        `;
            });

        });


        if (<%= locals.flash.success.length > 0 && locals.flash.success !== "" %>) {
            Swal.fire({
                position: "center",
                icon: "success",
                title: "<%= locals.flash.success %>",
                showConfirmButton: false,
                timer: 1500
            });
        }

        if (<%= locals.flash.error.length > 0 && locals.flash.error !== "" %>) {
            Swal.fire({
                position: "center",
                icon: "error",
                title: "<%= locals.flash.error %>",
                showConfirmButton: false,
                timer: 1500
            });
        }

        // header buttons dropdown logic
        const dropdownBtn = document.querySelector('.dropdown-btn');
        const userDropdown = document.querySelector('.user-dropdown');

        dropdownBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userDropdown.classList.toggle('active');
        });

        document.addEventListener('click', () => {
            userDropdown.classList.remove('active');
        });

        document.querySelectorAll('.sidebar-dropdown-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const parent = btn.parentElement;
                parent.classList.toggle('active');

                const menu = parent.querySelector('.sidebar-dropdown-menu');
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            });
        });


    </script>

    </body>

    </html>