<%- include('../header') %>
    <div class="main-content">
        <div class="content-header">
            <h1><i class="fas fa-tags"></i> Extra Categories</h1>
            <p>Manage all extra categories</p>
        </div>

        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th width="60">ID</th>
                        <th>Extra Category</th>
                        <th>Category</th>
                        <th>Sub Category</th>
                        <th>Image</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% allExtraCategories.map((category, index) => { %>
                        <tr>
                            <td>
                                <span class="badge badge-success">#<%= index + 1 %></span>
                            </td>
                            <td>
                                <strong style="color: white;"><%= category.extra_category_name %></strong>
                            </td>
                            <td>
                                <span style="color: rgba(226, 232, 240, 0.9);">
                                    <i class="fas fa-folder" style="color: #8B5CF6; margin-right: 8px;"></i>
                                    <%= category.category_id ? category.category_id.category_name : 'N/A' %>
                                </span>
                            </td>
                            <td>
                                <span style="color: rgba(226, 232, 240, 0.9);">
                                    <i class="fas fa-layer-group" style="color: #EC4899; margin-right: 8px;"></i>
                                    <%= category.sub_category_id ? category.sub_category_id.sub_category_name : 'N/A' %>
                                </span>
                            </td>
                            <td>
                                <% if(category.category_id && category.category_id.category_image) { %>
                                    <img src="../<%= category.category_id.category_image %>" alt="Category" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover; border: 2px solid rgba(139, 92, 246, 0.4);">
                                <% } else { %>
                                    <span style="color: rgba(226, 232, 240, 0.5);">No Image</span>
                                <% } %>
                            </td>
                            <td class="text-right">
                                <div class="action-buttons">
                                    <a href="/extraCategory/editExtraCategoryPage?extraCategoryId=<%= category.id %>" class="btn btn-sm btn-secondary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/extraCategory/deleteExtraCategory/<%= category.id %>" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <%- include('../footer') %>