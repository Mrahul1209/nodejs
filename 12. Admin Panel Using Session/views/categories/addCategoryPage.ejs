<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Add Category</h1>
            <p>Fill in the details below to add a new category.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i> Category Details</h3>

            <form action="/category/addCategory" method="POST" class="employee-form" enctype="multipart/form-data">
                <div class="form-grid">
                    <!-- first name section  -->
                    <div class="form-group">
                        <label for="firstName">Category Name</label>
                        <input type="text" id="firstName" name="category_name" placeholder="Category">
                    </div>

                    <!-- Category Image section  -->
                    <div class="form-group">
                        <label>Category Image</label>
                        <input type="file" id="category_image" name="category_image" required>
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Category
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../footer') %>