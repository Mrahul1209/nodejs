<%- include('../header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1>Edit Category</h1>
            <p>Fill in the details below to edit category.</p>
        </div>

        <div class="card form-card">
            <h3><i class="fas fa-plus"></i>Category Details</h3>

            <form action="/category/updateCategory/<%= editCategory.id %>" method="post" class="employee-form"
                enctype="multipart/form-data">
                <div class="form-grid">
                    <!-- first name section  -->
                    <div class="form-group">
                        <label for="category_name">Category Name</label>
                        <input type="text" id="category_name" name="category_name"
                            value="<%= editCategory.category_name %>">
                    </div>

                    <!-- Category Image section  -->
                    <div class="form-group">
                        <label>Category Image</label>
                        <img src="../../<%= editCategory.category_image %>" alt="" width="100">
                    </div>

                    <!-- Category Image section  -->
                    <div class="form-group">
                        <label>Category Image</label>
                        <input type="file" id="category_image" name="category_image">
                    </div>

                </div>

                <!-- submit buttons  -->
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Category
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('../footer') %>