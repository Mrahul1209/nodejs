<%- include('header') %>

    <main class="main-content" id="mainContent">
        <div class="content-header">
            <h1><i class="fas fa-user-edit"></i> Edit Admin</h1>
            <p>Update administrator details below</p>
        </div>

        <div class="card form-card">
            <form action="/updateAdmin/<%= editAdmin.id %>" method="POST" enctype="multipart/form-data">
                <div class="form-grid">
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> First Name</label>
                        <input type="text" name="firstName" value="<%= editAdmin.firstName %>" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Last Name</label>
                        <input type="text" name="lastName" value="<%= editAdmin.lastName %>" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-envelope"></i> Email Address</label>
                        <input type="email" name="email" value="<%= editAdmin.email %>" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-lock"></i> Password</label>
                        <input type="password" name="password" value="<%= editAdmin.password %>" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-phone"></i> Phone Number</label>
                        <input type="tel" name="phone" value="<%= editAdmin.phone %>" required>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-venus-mars"></i> Gender</label>
                        <div class="radio-group">
                            <label class="radio-card">
                                <input type="radio" name="gender" value="Male" <%= editAdmin.gender === "Male" ? "checked" : "" %>>
                                <span><i class="fas fa-mars"></i> Male</span>
                            </label>
                            <label class="radio-card">
                                <input type="radio" name="gender" value="Female" <%= editAdmin.gender === "Female" ? "checked" : "" %>>
                                <span><i class="fas fa-venus"></i> Female</span>
                            </label>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label><i class="fas fa-heart"></i> Hobbies</label>
                        <div class="checkbox-group">
                            <% ["Reading", "Travelling", "Music", "Sports", "Others"].map(hobby => { %>
                                <label class="checkbox-card">
                                    <input type="checkbox" name="hobbies" value="<%= hobby %>" <%= editAdmin.hobbies.includes(hobby) ? "checked" : "" %>>
                                    <span><%= hobby %></span>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-city"></i> City</label>
                        <select name="city" required>
                            <option value="">Select City</option>
                            <% ["Surat", "Jaipur", "Navsari", "Bhavnagar"].map(city => { %>
                                <option value="<%= city %>" <%= editAdmin.city === city ? "selected" : "" %>><%= city %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label><i class="fas fa-image"></i> Profile Image</label>
                        <div class="image-preview">
                            <img src="../<%= editAdmin.profileImage %>" alt="Profile">
                        </div>
                        <input type="file" name="profileImage" accept="image/*" style="margin-top: 1rem;">
                    </div>

                    <div class="form-group full-width">
                        <label><i class="fas fa-info-circle"></i> About</label>
                        <textarea name="about" rows="4"><%= editAdmin.about %></textarea>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="reset" class="btn btn-secondary">
                        <i class="fas fa-undo"></i> Reset
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Admin
                    </button>
                </div>
            </form>
        </div>
    </main>

    <%- include('footer') %>