<%- include('header') %>
    <div class="main-content">
        <div class="content-header">
            <h1><i class="fas fa-users-cog"></i> Admin Directory</h1>
            <p>Manage all registered administrators and their details</p>
        </div>

        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th width="60">ID</th>
                        <th>Admin Profile</th>
                        <th>Contact Info</th>
                        <th>Location</th>
                        <th>Hobbies</th>
                        <% if(findAdmin.email==="rm0539649@gmail.com") { %>
                            <th class="text-right">Actions</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% allAdminData.map((admin, index) => { %>
                        <tr>
                            <td>
                                <% if(admin.email==="rm0539649@gmail.com") { %>
                                    <span class="badge badge-warning" style="font-size: 1.2rem;">♕</span>
                                <% } else { %>
                                    <span class="badge badge-success">#<%= index + 1 %></span>
                                <% } %>
                            </td>
                            <td>
                                <div class="profile-cell">
                                    <img src="<%= admin.profileImage %>" class="mini-avatar" alt="<%= admin.firstName %>">
                                    <div>
                                        <strong style="color: white; font-size: 1.05rem;">
                                            <%= admin.firstName %> <%= admin.lastName %>
                                        </strong>
                                        <br>
                                        <small style="color: rgba(226, 232, 240, 0.7);">
                                            <i class="fas fa-<%= admin.gender === 'Male' ? 'mars' : 'venus' %>"></i>
                                            <%= admin.gender %>
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <span style="color: rgba(226, 232, 240, 0.9);">
                                        <i class="fas fa-envelope" style="color: #8B5CF6; margin-right: 8px;"></i>
                                        <%= admin.email %>
                                    </span>
                                    <span style="color: rgba(226, 232, 240, 0.9);">
                                        <i class="fas fa-phone" style="color: #10B981; margin-right: 8px;"></i>
                                        <%= admin.phone %>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <span style="color: rgba(226, 232, 240, 0.9);">
                                    <i class="fas fa-map-marker-alt" style="color: #EC4899; margin-right: 8px;"></i>
                                    <%= admin.city %>
                                </span>
                            </td>
                            <td>
                                <span style="color: rgba(226, 232, 240, 0.9);">
                                    <i class="fas fa-heart" style="color: #EF4444; margin-right: 8px;"></i>
                                    <%= admin.hobbies %>
                                </span>
                            </td>
                            <% if(findAdmin.email==="rm0539649@gmail.com") { %>
                                <td class="text-right">
                                    <div class="action-buttons">
                                        <a href="/editAdmin/<%= admin.id %>" class="btn btn-sm btn-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/deleteAdmin/<%= admin.id %>" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <%- include('footer') %>