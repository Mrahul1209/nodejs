<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ModernGlass - Premium Admin Panel</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">

    <!-- Main CSS -->
    <link rel="stylesheet" href="/public/style.css" type="text/css">
</head>

<body>
    <!-- Glassmorphism Navbar -->
    <nav class="navbar">
        <div class="logo">
            <i class="fas fa-gem"></i>
            <span>ModernGlass</span>
        </div>

        <div class="user-actions">
            <div class="user-dropdown">
                <button class="login-btn dropdown-btn">
                    <i class="fas fa-user-circle"></i>
                    <span>Account</span>
                    <i class="fas fa-chevron-down"></i>
                </button>

                <div class="dropdown-menu">
                    <a href="/changePasswordPage">
                        <i class="fas fa-key"></i> Change Password
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>

        <div class="mobile-toggle" id="mobileToggle">
            <i class="fas fa-bars"></i>
        </div>
    </nav>

    <!-- Glassmorphism Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/profile">
                <h3>
                    <i class="fas fa-crown"></i>
                    <%= findAdmin.firstName %>
                        <%= findAdmin.lastName %>
                </h3>
            </a>
        </div>

        <ul class="sidebar-menu">
            <li>
                <a href="/dashboardPage">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/viewAdminPage">
                    <i class="fas fa-chart-line"></i>
                    <span>View</span>
                </a>
            </li>
            <li>
                <a href="/addAdminFormPage">
                    <i class="fas fa-user-plus"></i>
                    <span>Add Form</span>
                </a>
            </li>

            <!-- Category Dropdown -->
            <li class="sidebar-dropdown">
                <button class="sidebar-dropdown-btn">
                    <span>
                        <i class="fas fa-list"></i> Category
                    </span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </button>

                <ul class="sidebar-dropdown-menu">
                    <li>
                        <a href="/category/addCategoryPage">
                            <i class="fas fa-plus"></i> Add Category
                        </a>
                    </li>
                    <li>
                        <a href="/category/allCategoryViewPage">
                            <i class="fas fa-eye"></i> View Category
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Sub Category Dropdown -->
            <li class="sidebar-dropdown">
                <button class="sidebar-dropdown-btn">
                    <span>
                        <i class="fas fa-layer-group"></i> Sub Category
                    </span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </button>

                <ul class="sidebar-dropdown-menu">
                    <li>
                        <a href="/subCategory/addSubCategoryPage">
                            <i class="fas fa-plus"></i> Add Sub Category
                        </a>
                    </li>
                    <li>
                        <a href="/subCategory/viewSubCategoryPage">
                            <i class="fas fa-eye"></i> View Sub Category
                        </a>
                    </li>
                </ul>
            </li>

            <!-- Extra Category Dropdown -->
            <li class="sidebar-dropdown">
                <button class="sidebar-dropdown-btn">
                    <span>
                        <i class="fas fa-tags"></i> Extra Category
                    </span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </button>

                <ul class="sidebar-dropdown-menu">
                    <li>
                        <a href="/extraCategory/addExtraCategoryPage">
                            <i class="fas fa-plus"></i> Add Extra Category
                        </a>
                    </li>
                    <li>
                        <a href="/extraCategory/viewAllExtraCategoryPage">
                            <i class="fas fa-eye"></i> View Extra Category
                        </a>
                    </li>
                </ul>
            </li>

            <li class="sidebar-dropdown">
                <button class="sidebar-dropdown-btn">
                    <span>
                        <i class="fas fa-tags"></i> Products
                    </span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </button>

                <ul class="sidebar-dropdown-menu">
                    <li>
                        <a href="/product/addProductPage">
                            <i class="fas fa-plus"></i> Add Products
                        </a>
                    </li>
                    <li>
                        <a href="/product/viewAllProductPage">
                            <i class="fas fa-eye"></i> View Products
                        </a>
                    </li>
                </ul>
            </li>
        </ul>

        <div class="sidebar-divider"></div>
    </aside>

    <!-- Overlay for mobile -->
    <div class="overlay" id="overlay"></div>