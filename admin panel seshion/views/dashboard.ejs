<!DOCTYPE html>
<html lang="en" data-theme="cyber">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEO DASH | Ultra Modern Admin</title>

    <!-- Bootstrap 5 with Dark Theme -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-dark-5@1.1.3/dist/css/bootstrap-nightshade.min.css"
        rel="stylesheet">

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="../public/dist/style.css">

    <!-- GLASS EFFECT CSS -->
</head>

<body>
    <!-- ANIMATED BACKGROUND -->
    <div class="bg-animation">
        <div class="bg-circle"></div>
        <div class="bg-circle"></div>
        <div class="bg-circle"></div>
    </div>

    <!-- FLOATING PARTICLES -->
    <div id="particles-js"></div>

    <!-- SIDEBAR -->
    <aside id="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-logo">
                <i class="fas fa-bolt"></i>
            </div>
            <div class="brand-text">
                <h3>NEO DASH</h3>
                <small class="text-muted">Admin v3.0</small>
            </div>
        </div>

        <!-- Navigation Menu -->
        <ul class="nav-menu">
            <li class="nav-item">
                <a href="#" class="nav-link active">
                    <span class="nav-icon"><i class="fas fa-rocket"></i></span>
                    <span class="nav-text">Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-database"></i></span>
                    <span class="nav-text">Admin</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-shield-alt"></i></span>
                    <span class="nav-text">Add Admin</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <span class="nav-icon"><i class="fas fa-question-circle"></i></span>
                    <span class="nav-text">View Admin</span>
                </a>
            </li>
        </ul>

        <!-- User Profile -->
        <div class="profile-card glass-container mt-4">
            <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-1.2.1&auto=format&fit=crop&w=200&q=80"
                class="profile-img" alt="Admin">
            <div class="online-status"></div>
            <h5 class="mt-2">Rahul Carter</h5>
            <p class="text-muted">Super Admin</p>
            <button class="btn btn-neon btn-sm mt-2 w-100">
                <i class="fas fa-sign-out-alt me-2"></i> Logout
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        <!-- Top Bar -->
        <div class="top-bar">
            <div class="d-flex align-items-center">
                <div class="menu-toggle me-3" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </div>
                <h4 class="mb-0">Dashboard Overview</h4>
            </div>

            <div class="d-flex align-items-center">
                <!-- Theme Toggle -->
                <div class="theme-toggle me-3">
                    <button class="btn btn-neon btn-sm">
                        <i class="fas fa-moon me-2"></i> Dark Mode
                    </button>
                </div>

                <!-- Notifications -->
                <div class="dropdown me-3">
                    <button class="btn glass-container" type="button" data-bs-toggle="dropdown"
                        style="width: 50px; height: 50px;">
                        <i class="fas fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            5
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end glass-container" style="min-width: 300px;">
                        <li>
                            <h6 class="dropdown-header">Notifications</h6>
                        </li>
                        <li><a class="dropdown-item" href="#">New user registered</a></li>
                        <li><a class="dropdown-item" href="#">Order #1234 completed</a></li>
                        <li><a class="dropdown-item" href="#">Server updated</a></li>
                    </ul>
                </div>

                <!-- User Dropdown -->
                <div class="dropdown">
                    <button class="btn glass-container d-flex align-items-center" type="button"
                        data-bs-toggle="dropdown">
                        <img src="https://ui-avatars.com/api/?name=John+Carter&background=0D8ABC&color=fff"
                            class="rounded-circle me-2" width="35" alt="User">
                        <span>John Carter</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end glass-container">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i> Settings</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Stats Cards Row 1 -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card glass-container animate-slide" style="animation-delay: 0.1s;">
                    <div class="stat-icon" style="background: rgba(0, 212, 255, 0.2); color: var(--primary);">
                        <i class="fas fa-users"></i>
                    </div>
                    <h6 class="text-muted">TOTAL USERS</h6>
                    <h2 class="stat-value">12,548</h2>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">+12.5%</span>
                        <small class="text-muted">Since last month</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card glass-container animate-slide" style="animation-delay: 0.2s;">
                    <div class="stat-icon" style="background: rgba(255, 0, 128, 0.2); color: var(--secondary);">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h6 class="text-muted">TOTAL SALES</h6>
                    <h2 class="stat-value">$43,592</h2>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">+8.2%</span>
                        <small class="text-muted">Since last month</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card glass-container animate-slide" style="animation-delay: 0.3s;">
                    <div class="stat-icon" style="background: rgba(0, 255, 136, 0.2); color: var(--accent);">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h6 class="text-muted">REVENUE</h6>
                    <h2 class="stat-value">$18,230</h2>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">+15.3%</span>
                        <small class="text-muted">Since last month</small>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card glass-container animate-slide" style="animation-delay: 0.4s;">
                    <div class="stat-icon" style="background: rgba(147, 51, 234, 0.2); color: #9333ea;">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h6 class="text-muted">ACTIVE NOW</h6>
                    <h2 class="stat-value">1,245</h2>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-success me-2">Live</span>
                        <small class="text-muted">Users online</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row mb-4">
            <div class="col-lg-8 mb-4">
                <div class="chart-container">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5>Sales Analytics</h5>
                        <div class="btn-group">
                            <button class="btn btn-sm glass-container">Week</button>
                            <button class="btn btn-sm glass-container active">Month</button>
                            <button class="btn btn-sm glass-container">Year</button>
                        </div>
                    </div>
                    <canvas id="salesChart" height="250"></canvas>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="chart-container">
                    <h5 class="mb-4">Traffic Sources</h5>
                    <canvas id="trafficChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Tables & Quick Stats -->
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="chart-container">
                    <h5 class="mb-4">Recent Orders</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#ORD-7841</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=John+Doe&background=random"
                                                class="rounded-circle me-2" width="30" alt="">
                                            John Doe
                                        </div>
                                    </td>
                                    <td>12 Oct, 2023</td>
                                    <td>$249.99</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>#ORD-7840</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=Emma+Smith&background=random"
                                                class="rounded-circle me-2" width="30" alt="">
                                            Emma Smith
                                        </div>
                                    </td>
                                    <td>11 Oct, 2023</td>
                                    <td>$149.99</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>#ORD-7839</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=Mike+Johnson&background=random"
                                                class="rounded-circle me-2" width="30" alt="">
                                            Mike Johnson
                                        </div>
                                    </td>
                                    <td>10 Oct, 2023</td>
                                    <td>$399.99</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>#ORD-7838</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=Sarah+Williams&background=random"
                                                class="rounded-circle me-2" width="30" alt="">
                                            Sarah Williams
                                        </div>
                                    </td>
                                    <td>9 Oct, 2023</td>
                                    <td>$199.99</td>
                                    <td><span class="badge bg-danger">Cancelled</span></td>
                                </tr>
                                <tr>
                                    <td>#ORD-7837</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=Robert+Brown&background=random"
                                                class="rounded-circle me-2" width="30" alt="">
                                            Robert Brown
                                        </div>
                                    </td>
                                    <td>8 Oct, 2023</td>
                                    <td>$299.99</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="chart-container">
                    <h5 class="mb-4">Quick Actions</h5>
                    <div class="d-grid gap-3">
                        <button class="btn btn-neon">
                            <i class="fas fa-plus me-2"></i> Add New Product
                        </button>
                        <button class="btn glass-container">
                            <i class="fas fa-download me-2"></i> Export Data
                        </button>
                        <button class="btn glass-container">
                            <i class="fas fa-chart-pie me-2"></i> Generate Report
                        </button>
                        <button class="btn glass-container">
                            <i class="fas fa-bell me-2"></i> Send Notification
                        </button>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        <h6 class="mb-3">System Status</h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>CPU Usage</small>
                                <small>65%</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-primary" style="width: 65%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Memory</small>
                                <small>42%</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: 42%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Storage</small>
                                <small>78%</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-warning" style="width: 78%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="mt-5 pt-4 border-top border-secondary">
            <div class="row">
                <div class="col-md-6">
                    <p class="text-muted">
                        &copy; 2023 <span class="text-primary">NEO DASH</span>. All rights reserved.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted">
                        <i class="fas fa-circle text-success me-1"></i> System Status:
                        <span class="text-success">All Systems Operational</span>
                    </p>
                </div>
            </div>
        </footer>
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>

    <script>
        // Wait for DOM to load
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Particles.js
            particlesJS('particles-js', {
                particles: {
                    number: { value: 80, density: { enable: true, value_area: 800 } },
                    color: { value: "#00d4ff" },
                    shape: { type: "circle" },
                    opacity: { value: 0.3, random: true },
                    size: { value: 3, random: true },
                    line_linked: {
                        enable: true,
                        distance: 150,
                        color: "#00d4ff",
                        opacity: 0.2,
                        width: 1
                    },
                    move: {
                        enable: true,
                        speed: 2,
                        direction: "none",
                        random: true,
                        straight: false,
                        out_mode: "out",
                        bounce: false
                    }
                },
                interactivity: {
                    detect_on: "canvas",
                    events: {
                        onhover: { enable: true, mode: "repulse" },
                        onclick: { enable: true, mode: "push" }
                    }
                }
            });

            // Sidebar Toggle
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.querySelector('.main-content');

            menuToggle.addEventListener('click', function () {
                sidebar.classList.toggle('sidebar-hidden');
                mainContent.classList.toggle('full-width');
                this.querySelector('i').classList.toggle('fa-bars');
                this.querySelector('i').classList.toggle('fa-times');
            });

            // Initialize Charts
            const salesCtx = document.getElementById('salesChart').getContext('2d');
            const salesChart = new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                    datasets: [{
                        label: 'Sales',
                        data: [12000, 19000, 15000, 25000, 22000, 30000, 28000],
                        borderColor: '#00d4ff',
                        backgroundColor: 'rgba(0, 212, 255, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#00d4ff',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: '#fff' }
                        },
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: '#fff' }
                        }
                    }
                }
            });

            const trafficCtx = document.getElementById('trafficChart').getContext('2d');
            const trafficChart = new Chart(trafficCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Direct', 'Social', 'Referral', 'Organic'],
                    datasets: [{
                        data: [40, 25, 20, 15],
                        backgroundColor: [
                            '#00d4ff',
                            '#ff0080',
                            '#00ff88',
                            '#9333ea'
                        ],
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#fff', padding: 20 }
                        }
                    }
                }
            });

            // Add hover effects to all cards
            document.querySelectorAll('.stat-card').forEach(card => {
                card.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-10px) scale(1.02)';
                });

                card.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0) scale(1)';
                });
            });

            // Theme Toggle
            const themeBtn = document.querySelector('.theme-toggle .btn');
            themeBtn.addEventListener('click', function () {
                const icon = this.querySelector('i');
                if (icon.classList.contains('fa-moon')) {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun');
                    this.innerHTML = '<i class="fas fa-sun me-2"></i> Light Mode';
                    document.body.style.background = 'linear-gradient(135deg, #f0f2f5 0%, #ffffff 100%)';
                } else {
                    icon.classList.remove('fa-sun');
                    icon.classList.add('fa-moon');
                    this.innerHTML = '<i class="fas fa-moon me-2"></i> Dark Mode';
                    document.body.style.background = 'linear-gradient(135deg, #0a0a1a 0%, #121230 50%, #0a0a1a 100%)';
                }
            });

            // Add click animations to buttons
            document.querySelectorAll('.btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    this.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 200);
                });
            });

            // Simulate live data updates
            setInterval(() => {
                const activeUsers = document.querySelector('.stat-card:nth-child(4) .stat-value');
                const currentUsers = parseInt(activeUsers.textContent.replace(',', ''));
                const newUsers = currentUsers + Math.floor(Math.random() * 10) - 3;
                activeUsers.textContent = Math.max(1200, newUsers).toLocaleString();
            }, 5000);
        });
    </script>
</body>

</html>