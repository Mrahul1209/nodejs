<%- include('../header') %>

    <div class="page-wrapper">
        <div class="page-breadcrumb">
            <div class="row">
                <div class="col-12 d-flex no-block align-items-center">
                    <h4 class="page-title">All Admin</h4>
                    <div class="ml-auto text-right">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="#">Home</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Library</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Basic Datatable</h5>
                            <div class="table-responsive">
                                <table id="zero_config" class="table table-striped table-bordered">
                                    <thead class="text-center">
                                        <tr>
                                            <th>No</th>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email</th>
                                            <th>Password</th>
                                            <th>Phone</th>
                                            <th>Gender</th>
                                            <th>Hobby</th>
                                            <th>City</th>
                                            <th>About</th>
                                            <th>Image</th>
                                            <% if(admin.id==="696dc99c1e970306f2d911f0" ) {%>
                                                <th colspan="2">Action</th>
                                                <% }%>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% allAdmin.map((data, index)=> { %>
                                            <tr>
                                                <td>
                                                    <%= index + 1%>
                                                </td>

                                                <td>
                                                    <%= data.fname %>
                                                </td>

                                                <td>
                                                    <%= data.lname %>
                                                </td>
                                                <td>
                                                    <%= data.email %>
                                                </td>
                                                <td>
                                                    <%= data.password %>
                                                </td>
                                                <td>
                                                    <%= data.phone %>
                                                </td>
                                                <td>
                                                    <%= data.gender %>
                                                </td>
                                                <td>
                                                    <%= data.hobby %>
                                                </td>
                                                <td>
                                                    <%= data.city %>
                                                </td>
                                                <td>
                                                    <%= data.about %>
                                                </td>
                                                <td>
                                                    <img src="<%= data.profile_image %>" width="100" alt="">
                                                </td>

                                                <% if(admin.id==="696dc99c1e970306f2d911f0" ) {%>
                                                    <td>
                                                        <button class="btn btn-danger"><a
                                                                href="/deleteAdmin?adminId=<%= data.id %>"
                                                                style="color: white;">Delete</a></button>
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-warning"><a
                                                                href="/editAdmin/<%= data.id %>"
                                                                style="color: white;">Edit</a></button>
                                                    </td>
                                                    <% }%>


                                            </tr>

                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>


        <%- include('../footer') %>